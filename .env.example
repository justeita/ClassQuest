# Salin ke .env.local lalu isi nilainya. Jangan commit .env.local.
# Nama variabel mengikuti docs/08-workflow/setup.md dan
# docs/03-ai-pipeline/provider-setup.md. ADR 0006 masih terbuka, jadi jangan
# memakai nama provider sungguhan sebagai nilai default.

# Required. See docs/03-ai-pipeline/provider-setup.md for supported values.
AI_PROVIDER=
AI_API_KEY=
# Example for Anthropic: claude-sonnet-5-5 (check the provider's current model list)
AI_MODEL=
# Opsional, untuk gateway/self-hosted
AI_BASE_URL=
AI_TIMEOUT_MS=60000
