# Salin ke .env.local lalu isi nilainya. Jangan commit .env.local.
# Nama variabel mengikuti docs/08-workflow/setup.md dan
# docs/03-ai-pipeline/provider-setup.md. ADR 0006 masih terbuka, jadi jangan
# memakai nama provider sungguhan sebagai nilai default.

# Required. See docs/03-ai-pipeline/provider-setup.md for supported values.
AI_PROVIDER=
AI_API_KEY=
# Example for Anthropic: claude-sonnet-5-5 (check the provider's current model list)
AI_MODEL=
# Opsional, untuk gateway/self-hosted
AI_BASE_URL=
AI_TIMEOUT_MS=60000
# Opsional. Isi "on" untuk mengajari model membuat konsekuensi jawaban salah
# (soal ulang + detour singkat, plus textVariants). Kosong = mati.
AI_BRANCHING=
# Untuk model reasoning (mis. deepseek-*), isi "on": reasoning memakai 25-45
# detik per panggilan sehingga deadline 240 detik tidak cukup (ADR 0018).
# Kosongkan hanya bila batas fungsi hosting >300 detik. Saat "on", pipeline
# mengirim thinking:{type:"disabled"}.
AI_DISABLE_THINKING=

# Akun guru (penghalang demo) ada di tabel `teachers`: login memakai
# username + password, password disimpan sebagai hash scrypt.
# Isi akun awal lewat `bun run db:seed`. Wajib diisi; tidak ada akun demo
# bawaan. Keempat variabel harus terisi sebelum seed.
TEACHER_SEED_USERNAME=
TEACHER_SEED_PASSWORD=
# Akun siswa disiapkan untuk fase berikutnya; /play tetap berbasis tautan.
STUDENT_SEED_USERNAME=
STUDENT_SEED_PASSWORD=
# Kunci HMAC untuk cookie sesi guru. Wajib; kosong = login selalu gagal.
TEACHER_SESSION_SECRET=

# Database libSQL. Kosong = file lokal ./local.db untuk development.
DATABASE_URL=
# Hanya untuk database remote. Biarkan kosong untuk file lokal.
DATABASE_AUTH_TOKEN=
