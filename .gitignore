# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# runtime data (local dev only)
/data/
/uploads/
# local libSQL/SQLite database (DATABASE_URL default)
/local.db
/local.db-*

# misc
.DS_Store
*.pem
# skrip coba-coba pemilik repo, tidak ikut di-commit
/scripts/build-nino-sprite.mjs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

package-lock.json
yarn.lock
pnpm-lock.yaml

.vscode
handoff.md